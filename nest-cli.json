{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/rent-kar-ride-kar/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/rent-kar-ride-kar/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/rent-kar-ride-kar",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/proto/*.proto",
            "outDir": "../../../libs/proto",
            "watchAssets": true
          }
        ]
      }
    },
    "auth": {
